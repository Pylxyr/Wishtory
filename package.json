{
  "name": "wishtory-tools",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "Catalog and release tooling only. The app itself is Flutter (app/) over Rust (crates/).",
  "scripts": {
    "catalog:update": "node scripts/update-catalog.mjs",
    "catalog:test": "node --test scripts/update-catalog.test.mjs scripts/prepare-catalog.test.mjs scripts/track-banners.test.mjs scripts/changelog.test.mjs",
    "banners:track": "node scripts/track-banners.mjs",
    "scripts:test": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "catalog:sign": "node scripts/sign-catalog.mjs"
  }
}
