# Maintainer: Wishtory contributors
#
# Builds Wishtory from a release tag for Arch Linux and derivatives (CachyOS, EndeavourOS, Manjaro).
#   cd packaging/arch/wishtory && makepkg -si
# The checksum below is a placeholder until the tag exists: after tagging, run `updpkgsums` to fill it
# in, and do the same after every change of _tag. To build the current source instead, use
# ../wishtory-git. Not on the AUR yet.
#
# The app is a Tauri program: Rust for the core, Svelte for the window, WebKitGTK to show it. The first
# build downloads the Rust crates and the npm packages, so it needs the network.
pkgname=wishtory
_tag=0.6.0-rc2
# Arch versions cannot contain a hyphen.
pkgver=${_tag//-/}
pkgrel=1
pkgdesc='Local wish history manager for Genshin Impact, Honkai: Star Rail and Zenless Zone Zero'
arch=('x86_64')
url='https://github.com/Pylxyr/Wishtory'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'xdg-utils')
makedepends=('rust' 'nodejs' 'npm' 'pkgconf')
options=('!lto')
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('SKIP')

_src() { echo "$srcdir/Wishtory-$_tag"; }

prepare() {
  cd "$(_src)"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci --no-audit --no-fund
}

build() {
  cd "$(_src)"
  # --no-bundle: this PKGBUILD installs the files itself, so no .deb or AppImage is made.
  npm run tauri -- build --no-bundle
}

package() {
  cd "$(_src)"
  install -Dm755 target/release/wishtory "$pkgdir/usr/bin/wishtory"
  install -Dm644 packaging/linux/wishtory.desktop "$pkgdir/usr/share/applications/wishtory.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/wishtory.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/wishtory.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/wishtory.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/wishtory.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
